# A GitHub PAT with permission to mint runner registration tokens for the org
# (classic: admin:org). entrypoint.sh exchanges it for a registration token on first
# start, so runners self-register without a human pasting a 1-hour token.
#
# Alternatively set RUNNER_TOKEN to a registration token from
# Settings -> Actions -> Runners -> New self-hosted runner. It expires in ~1 hour and is
# only consulted when ACCESS_TOKEN is unset.
#
# On the LXC this is /opt/gh-runner-docker/.env (service `runner`) and
# /opt/gh-runner-docker/runners.env (services `runner-2` .. `runner-4`), both chmod 600.
ACCESS_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
